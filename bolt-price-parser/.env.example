# ─── Доступы Bolt Business (business.bolt.eu) ───────────────────────────
# ВАЖНО: не коммитьте реальный .env. Файл .env добавлен в .gitignore.
BOLT_EMAIL=your-email@example.com
BOLT_PASSWORD=your-password

# Портал (обычно менять не нужно)
BOLT_BASE_URL=https://business.bolt.eu

# Адрес самого кабинета после входа. Корень business.bolt.eu — рекламная
# страница, поэтому лучше указать точный URL. Его подскажет `npm run login`
# после успешного входа — просто скопируйте выведенное значение сюда.
BOLT_PORTAL_URL=

# Город/страна по умолчанию (для контекста и подсказок адресов)
BOLT_DEFAULT_CITY=Rīga
BOLT_DEFAULT_COUNTRY=Latvia

# ─── Браузер ────────────────────────────────────────────────────────────
# HEADLESS влияет на сервер (npm start). Команда `npm run login` всегда
# открывает видимое окно, даже при HEADLESS=true — иначе нельзя ввести OTP.
# Headless-login только явно: `npm run login -- --headless` или LOGIN_HEADLESS=1.
HEADLESS=true
NAV_TIMEOUT_MS=45000
# Общий потолок одного запроса цен (логин + адреса + API), мс
REQUEST_TIMEOUT_MS=90000
SLOW_MO=0
BROWSER_LOCALE=en-US

# Координаты по умолчанию (центр Риги)
GEO_LAT=56.9496
GEO_LNG=24.1052

# ─── Сервер / безопасность ──────────────────────────────────────────────
# По умолчанию только localhost. Чтобы слушать все интерфейсы: HOST=0.0.0.0
HOST=127.0.0.1
PORT=4000

# Опциональный токен для POST /api/prices. Если задан — нужен заголовок
# Authorization: Bearer <токен> (веб-UI подставляет его сам через /app-config.js).
# Для чисто локального использования можно оставить пустым.
API_TOKEN=

# Простой per-IP лимит на POST /api/prices (без внешних зависимостей)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Сохранять скриншот + захваченный JSON при каждом запросе (для отладки вёрстки)
DEBUG_CAPTURE=0
